# Local. El API corre en su propio puerto, asi que la URL es absoluta y el CORS de
# appsettings.Development.json permite el 5173.
VITE_API_BASE_URL=http://localhost:5068/api
VITE_AUTH_AUTHORITY=https://authserverqa.rehabilitacion.org.do
VITE_AUTH_CLIENT_ID=logi-track-app
VITE_AUTH_RESPONSE_TYPE=code
# El backend (HttpUserContext) espera los claims roles, permissions, affiliate y position.
VITE_AUTH_SCOPES=openid profile roles
