# Cada entorno tiene su propio archivo, y los tres estan versionados porque solo llevan URLs
# publicas y el identificador de la aplicacion. Son autocontenidos a proposito: al abrir
# .env.production se ve exactamente con que se construye produccion.
#
#   .env.development   npm run dev      (modo development)
#   .env.qa            npm run build:qa (modo qa)
#   .env.production    npm run build    (modo production)
#
# Este .env local es opcional y esta ignorado por git. Los archivos por modo tienen prioridad
# sobre el, asi que solo sirve para pruebas puntuales, nunca para configurar un despliegue.
VITE_API_BASE_URL=http://localhost:5068/api
VITE_AUTH_AUTHORITY=https://authserverqa.rehabilitacion.org.do
VITE_AUTH_CLIENT_ID=logi-track-app
VITE_AUTH_RESPONSE_TYPE=code
VITE_AUTH_SCOPES=openid profile roles
